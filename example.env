# Token del bot que te da @BotFather en Telegram
TELEGRAM_BOT_TOKEN=

# Tu API key gratis de Google AI Studio (aistudio.google.com/apikey) - sin tarjeta
GOOGLE_API_KEY=

# Tu integration token de Notion (notion.so/my-integrations)
NOTION_API_KEY=

# IDs de los data sources en Notion (ya vienen con los valores correctos de tu workspace)
GASTOS_DATA_SOURCE_ID=2d56cb1b-5b1d-814d-aef7-000bd8c2a937
INGRESOS_DATA_SOURCE_ID=2d56cb1b-5b1d-81f6-97b6-000b6027bcd1
TRANSFERENCIAS_DATA_SOURCE_ID=2d56cb1b-5b1d-81e8-8154-000b20332848

# IDs numéricos de Telegram de Cris y Mari, separados por coma.
# Déjalo vacío si quieres que cualquiera pueda usar el bot (no recomendado).
# Para obtener tu ID, escríbele a @userinfobot en Telegram.
ALLOWED_TELEGRAM_USER_IDS=
